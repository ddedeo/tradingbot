# Copy this file to .env and fill in your keys.

# Alpaca PAPER trading keys: https://app.alpaca.markets (Paper account -> API Keys)
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# Anthropic API key for the AI trade reviewer: https://console.anthropic.com
# Only needed when "ai": {"enabled": true} in config.json.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
